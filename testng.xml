<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite Framework Híbrido Completo">

       <!-- REGISTRO DEL CAPTURADOR DE FALLAS GLOBAL -->
    <listeners>
        <listener class-name="utils.ErrorHandling"/>
    </listeners>

    <!-- 1. BLOQUE DE PRUEBAS API (Se ejecuta primero y no abre navegadores) -->
    <test name="Pruebas de Servicios Backend API">
        <classes>
            <class name="api.tests.DogApiTest"/>
        </classes>
    </test>

    <!-- 2. BLOQUES DE PRUEBAS WEB UI (Multi-browser secuencial) -->
    
    <!-- Ejecución en Google Chrome -->
    <test name="Pruebas de Interfaz Web - Chrome">
        <parameter name="navegador" value="chrome"/>
        <classes>
            <class name="tests.GoogleTest"/>
        </classes>
    </test>

    <!-- Ejecución en Mozilla Firefox -->
    <test name="Pruebas de Interfaz Web - Firefox">
        <parameter name="navegador" value="firefox"/>
        <classes>
            <class name="tests.GoogleTest"/>
        </classes>
    </test>

    <!-- Ejecución en Microsoft Edge -->
    <test name="Pruebas de Interfaz Web - Edge">
        <parameter name="navegador" value="edge"/>
        <classes>
            <class name="tests.GoogleTest"/>
        </classes>
    </test>

</suite>


